---
/*
  Override of Starlight's PageFrame.

  The course outline lives in a left column that is always reserved on wide screens, so
  opening or closing it never moves the lesson text or the "On this page" list. It starts
  closed, the learner opens it with the button at the start of the header, and the choice is
  remembered between pages. On narrow screens it is an overlay drawer instead.
*/
import MenuToggle from './MenuToggle.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
	<header class="header"><slot name="header" /></header>
	{
		hasSidebar && (
			<nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
				<MenuToggle />
				<script>
					const STORAGE_KEY = 'opm-sidebar';
					const wide = matchMedia('(min-width: 50em)');

					class CourseSidebarPane extends HTMLElement {
						constructor() {
							super();
							// Wide screens: a pinned panel that stays until toggled. Narrow: a light-dismiss drawer.
							const setMode = () => {
								this.popover = wide.matches ? 'manual' : 'auto';
							};
							setMode();
							wide.addEventListener('change', setMode);

							this.addEventListener('toggle', (event) => {
								const open = (event as ToggleEvent).newState === 'open';
								if (wide.matches) {
									try {
										localStorage.setItem(STORAGE_KEY, open ? 'open' : 'closed');
									} catch {}
								} else {
									this.trapFocus(open);
								}
							});
						}
						connectedCallback() {
							// Restore the learner's last choice on wide screens. Default is closed.
							let remembered = 'closed';
							try {
								remembered = localStorage.getItem(STORAGE_KEY) || 'closed';
							} catch {}
							if (wide.matches && remembered === 'open' && !this.matches(':popover-open')) {
								try {
									this.showPopover();
								} catch {}
							}
						}
						trapFocus(shouldTrap: boolean) {
							document.querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link').forEach((el) => {
								el.toggleAttribute('inert', shouldTrap);
							});
						}
					}
					customElements.define('course-sidebar-pane', CourseSidebarPane);
				</script>
				<course-sidebar-pane popover="auto" id="starlight__sidebar" class="sidebar-pane">
					<div class="sidebar-content sl-flex">
						<slot name="sidebar" />
					</div>
				</course-sidebar-pane>
			</nav>
		)
	}
	<div class="main-frame"><slot /></div>
</div>

<style>
	@layer starlight.core {
		.page {
			flex-direction: column;
			min-height: 100vh;
		}

		.header {
			z-index: var(--sl-z-index-navbar);
			position: fixed;
			inset-inline-start: 0;
			inset-block-start: 0;
			width: 100%;
			height: var(--sl-nav-height);
			border-bottom: 1px solid var(--sl-color-hairline-shade);
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			background-color: var(--sl-color-bg-nav);
		}

		/* Leave room for the menu button at the start of the header. */
		:global([data-has-sidebar]) .header {
			padding-inline-start: calc(var(--sl-nav-pad-x) + var(--sl-menu-button-size) + 0.75rem);
		}

		.sidebar-pane {
			border: unset;
			padding: unset;
			height: unset;
			color: unset;

			position: fixed;
			z-index: var(--sl-z-index-menu);
			inset-block: var(--sl-nav-height) 0;
			inset-inline-start: 0;
			width: 100%;
			background-color: var(--sl-color-black);
			overflow-y: auto;
			scrollbar-gutter: stable;
		}

		.sidebar-content {
			height: 100%;
			min-height: max-content;
			padding: 1rem var(--sl-sidebar-pad-x) 0;
			flex-direction: column;
			gap: 1rem;
		}

		.main-frame {
			padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
			padding-inline-start: var(--sl-content-inline-start);
		}

		@media (min-width: 50rem) {
			/* The left column is reserved whether or not the panel is open, so content never moves. */
			.sidebar-pane {
				width: var(--sl-sidebar-width);
				background-color: var(--sl-color-bg-sidebar);
				border-inline-end: 1px solid var(--sl-color-hairline-shade);
			}
			.sidebar-content::after {
				content: '';
				padding-bottom: 1px;
			}
		}
	}
</style>
